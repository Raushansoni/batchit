rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // In-app update metadata — anyone can read; only Admin SDK (CI) can write.
    match /config/app_update {
      allow read: if true;
      allow write: if false;
    }

    // Temporary open access for non-config data until Aug 21, 2026.
    // Replace with least-privilege rules before that date.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'config'
        && request.time < timestamp.date(2026, 8, 21);
    }
  }
}
